    "vue-router": "^4.2.5",
    "vuetify": "^3.9.6"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "typescript": "^6.0.3",
